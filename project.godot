config_version=5

[application]
config/name="Echo Ridge"
config/version="0.4.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7")

[autoload]

GameState="*res://autoload/game_state.gd"
Settings="*res://autoload/settings.gd"
SaveSystem="*res://autoload/save_system.gd"
Loadout="*res://autoload/loadout.gd"
Progression="*res://autoload/progression.gd"
StoryCampaign="*res://autoload/story_campaign.gd"
StoryDialogue="*res://autoload/story_dialogue.gd"
AudioDirector="*res://autoload/audio_director.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/echo_ridge.log"
file_logging/max_log_files=5

[display]
window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]
renderer/rendering_method="gl_compatibility"

